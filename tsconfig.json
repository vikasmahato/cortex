{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "types": ["node"],
    "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["packages/*/src", "apps/daemon/src"]
}
